# Application Settings
NEXT_PUBLIC_APP_NAME=StrataMDT
NEXT_PUBLIC_SERVER_NAME=StrataMDT

# Optional: Add custom branding
# NEXT_PUBLIC_LOGO_URL=/logo.png
# NEXT_PUBLIC_THEME_COLOR=#fbbf24

# Node Environment (set by Railway automatically)
# NODE_ENV=production

# FiveM bridge (see fivem/README.md)
# Shared secret the strata-mdt FiveM resource sends as "Authorization: Bearer <key>".
# Leave unset to keep the bridge disabled. Generate one with: openssl rand -hex 32
# FIVEM_API_KEY=
